% SmallPE Report Header — injected via pandoc header-includes
% This file is NOT a full pandoc template. It is included into pandoc's
% default LaTeX template via the defaults file. This keeps all of pandoc's
% internal plumbing (longtable, CSL, secnumdepth, etc.) intact.
%
% Usage: sed 's/→/-->/g' report.md | pandoc --defaults=templates/pandoc-defaults.yml -o report.pdf

% --- Core Packages ---
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{colortbl}
\usepackage{lastpage}
\usepackage{etoolbox}

% --- Color Palette ---
\definecolor{smallpeblue}{HTML}{1a1a2e}
\definecolor{smallpegray}{HTML}{6b7280}
\definecolor{accentblue}{HTML}{2563eb}
\definecolor{tableborder}{HTML}{d1d5db}

% --- Header / Footer ---
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\textcolor{smallpegray}{\small\sffamily SmallPE Investment Committee}}
\fancyhead[R]{\textcolor{smallpegray}{\small\sffamily Confidential}}
\fancyfoot[C]{\textcolor{smallpegray}{\small\sffamily Page \thepage\ of \pageref{LastPage}}}
\fancyfoot[R]{\textcolor{smallpegray}{\small\sffamily www.smallpe.com}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.2pt}

% --- Section Styling ---
\titleformat{\section}{\Large\bfseries\sffamily\color{smallpeblue}}{\thesection}{1em}{}
\titleformat{\subsection}{\large\bfseries\sffamily\color{smallpeblue}}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\sffamily\color{smallpeblue}}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{2em}{1em}
\titlespacing*{\subsection}{0pt}{1.5em}{0.75em}
\titlespacing*{\subsubsection}{0pt}{1em}{0.5em}

% --- Table Styling ---
\arrayrulecolor{tableborder}

% --- Paragraph Spacing ---
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% --- Last Page Attribution (fires at document end) ---
\AtEndDocument{%
  \vfill
  \begin{center}
  \rule{0.5\textwidth}{0.4pt}\\[0.75em]
  {\small\sffamily\color{smallpegray} Generated by SmallPE Agents --- \href{https://www.smallpe.com}{www.smallpe.com}}\\[0.25em]
  {\small\sffamily\color{smallpegray} Sponsored by \href{https://inloop.studio}{inloop.studio}}
  \end{center}
}
