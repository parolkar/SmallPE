{
  "name": "dsh-zapier-mcp",
  "version": "0.1.0",
  "description": "Connect your hosted Zapier MCP server (mcp.zapier.com) to DeepSeek Harness with a Settings page for the Zapier MCP token.",
  "type": "module",
  "license": "MIT",
  "author": "parolkar (https://github.com/parolkar)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parolkar/dsh-zapier-mcp.git"
  },
  "homepage": "https://github.com/parolkar/dsh-zapier-mcp#readme",
  "bugs": {
    "url": "https://github.com/parolkar/dsh-zapier-mcp/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "mcp",
    "zapier",
    "model-context-protocol",
    "automation"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --check index.js && node --check client.js && node --check lib/host-logic.js && node --check lib/prompt.js && node test/host.test.mjs && node test/prompt.test.mjs && node test/client.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0 <0.3.0"
    }
  }
}
