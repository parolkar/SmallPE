    "@deepseek-ai/dsh-browser-use": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
