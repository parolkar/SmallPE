{
  "name": "@local/smallpe-surface-switch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Classic-mode switch beside Settings at the sidebar foot.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
